# Copy to .env.local and fill in. Never commit the filled copy.
# Postgres on Supabase: pooled for the app, direct for migrations. Empty: a local PGlite in .data/ for development.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Development only: "1" adds a local sign-in on this machine. Ignored in production builds.
TEAMS_DEV_LOGIN=
