# Copy to .env.local and fill in. Never commit the filled copy. `neon env pull` (or `neon deploy`) writes the Neon lines.
# Lakebase Postgres on Neon: pooled for the app, direct for migrations. Empty: a local PGlite in .data/ for development.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
# Neon Auth (managed Better Auth) on the same branch: the sign-in.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Not from Neon: the secret for Neon Auth's cached session cookie.  openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
# 32 random bytes, base64, encrypting each tenant's Notion token at rest:  openssl rand -base64 32
TEAMS_ENCRYPTION_KEY=
# Development only: "1" adds a sign-in without Neon Auth on this machine. Ignored in production builds.
TEAMS_DEV_LOGIN=

# Development only (ignored in production builds): connect with the token in this file, no paste needed.
NOTION_TOKEN_FILE=
NOTION_LEADS_DATA_SOURCE=
NOTION_TASKS_DATA_SOURCE=

# Your deployed address (https://...): the sign-in link in a teammate's invite, and the files bucket's allowed origin.
NEXT_PUBLIC_APP_URL=
# Optional: the states a Google Maps lead import keeps by default, two-letter codes with commas (NY,NJ). Empty: any.
NEXT_PUBLIC_HOME_STATES=
