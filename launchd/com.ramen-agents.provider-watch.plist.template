<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ramen-agents.provider-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/Projects/bot/.venv/bin/python</string>
    <string>__HOME__/bots/scripts/provider_watch.py</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>__HOME__/bots/common-data/logs/provider-watch.out</string>
  <key>StandardErrorPath</key><string>__HOME__/bots/common-data/logs/provider-watch.err</string>
  <key>EnvironmentVariables</key><dict><key>HOME</key><string>__HOME__</string><key>PATH</key><string>/usr/local/bin:/usr/bin:/bin</string></dict>
</dict>
</plist>
