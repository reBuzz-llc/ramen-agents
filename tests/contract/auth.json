{
 "description": "Board API contract: auth (docs/design/board-api.md)",
 "cases": [
  {
   "name": "no key",
   "operation": "any",
   "request": {
    "method": "GET",
    "path": "/v1/boards/leads/schema",
    "headers": {
     "Authorization": ""
    }
   },
   "response": {
    "status": 401,
    "body": {
     "error": {
      "code": "unauthorized",
      "message": "send your agent key as a Bearer token"
     }
    }
   }
  },
  {
   "name": "a revoked or unknown key",
   "operation": "any",
   "request": {
    "method": "GET",
    "path": "/v1/boards/leads/schema",
    "headers": {
     "Authorization": "Bearer peek_test_revoked"
    }
   },
   "response": {
    "status": 401,
    "body": {
     "error": {
      "code": "unauthorized",
      "message": "that key is not active"
     }
    }
   }
  },
  {
   "name": "a key cannot delete rows",
   "operation": "delete",
   "request": {
    "method": "DELETE",
    "path": "/v1/rows/row_acme_bakery",
    "headers": {
     "Authorization": "Bearer peek_test_validator"
    }
   },
   "response": {
    "status": 405,
    "body": {
     "error": {
      "code": "method_not_allowed",
      "message": "rows are archived by people in the app, never deleted with a key"
     }
    }
   }
  },
  {
   "name": "a session cookie is not an API credential",
   "operation": "any",
   "request": {
    "method": "GET",
    "path": "/v1/boards/leads/schema",
    "headers": {
     "Authorization": "",
     "Cookie": "session=abc"
    }
   },
   "response": {
    "status": 401,
    "body": {
     "error": {
      "code": "unauthorized",
      "message": "send your agent key as a Bearer token"
     }
    }
   }
  }
 ]
}
