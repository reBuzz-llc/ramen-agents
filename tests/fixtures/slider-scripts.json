{
 "about": "the engine's review slider, exact text: the version before swipe and arrow keys (still on live pages) and the current one, from the engine's commit f0a2dd7",
 "previous": "(function(){var R=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;document.querySelectorAll('[data-slider]').forEach(function(box){var s=box.querySelectorAll('[data-slide]');if(s.length<2)return;var i=0,t=null,dots=box.querySelector('[data-slider-dots]');if(!dots){dots=document.createElement('div');dots.setAttribute('data-slider-dots','');box.appendChild(dots)}var b=[];function show(k){i=(k+s.length)%s.length;for(var j=0;j<s.length;j++){s[j].classList.toggle('is-active',j===i);s[j].setAttribute('aria-hidden',j===i?'false':'true');if(b[j]){b[j].classList.toggle('is-active',j===i);b[j].setAttribute('aria-current',j===i?'true':'false')}}}function stop(){if(t){clearInterval(t);t=null}}for(var j=0;j<s.length;j++){(function(k){var d=document.createElement('button');d.type='button';d.setAttribute('aria-label','Review '+(k+1));d.addEventListener('click',function(){stop();show(k)});dots.appendChild(d);b.push(d)})(j)}show(0);if(!R){t=setInterval(function(){show(i+1)},6000)}box.addEventListener('mouseenter',stop)})})();",
 "current": "(function(){var R=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;document.querySelectorAll('[data-slider]').forEach(function(box){var s=box.querySelectorAll('[data-slide]');if(s.length<2)return;var i=0,t=null,x=null,dots=box.querySelector('[data-slider-dots]');if(!dots){dots=document.createElement('div');dots.setAttribute('data-slider-dots','');box.appendChild(dots)}var b=[];function show(k){i=(k+s.length)%s.length;for(var j=0;j<s.length;j++){s[j].classList.toggle('is-active',j===i);s[j].setAttribute('aria-hidden',j===i?'false':'true');if(b[j]){b[j].classList.toggle('is-active',j===i);b[j].setAttribute('aria-current',j===i?'true':'false')}}}function stop(){if(t){clearInterval(t);t=null}}for(var j=0;j<s.length;j++){(function(k){var d=document.createElement('button');d.type='button';d.setAttribute('aria-label','Review '+(k+1));d.addEventListener('click',function(){stop();show(k)});dots.appendChild(d);b.push(d)})(j)}show(0);if(!R){t=setInterval(function(){show(i+1)},6000)}if(!box.hasAttribute('tabindex'))box.setAttribute('tabindex','0');box.addEventListener('mouseenter',stop);box.addEventListener('focusin',stop);box.addEventListener('keydown',function(e){if(e.key==='ArrowRight'||e.key==='ArrowLeft'){stop();show(i+(e.key==='ArrowRight'?1:-1));e.preventDefault()}});box.addEventListener('touchstart',function(e){stop();x=e.changedTouches[0].clientX},{passive:true});box.addEventListener('touchend',function(e){if(x===null)return;var d=e.changedTouches[0].clientX-x;x=null;if(Math.abs(d)>40)show(i+(d<0?1:-1))},{passive:true})})})();"
