<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- comment -%} every public page plus both llms files and the brochure {%- endcomment -%}
{%- for p in site.html_pages -%}
{%- unless p.sitemap == false or p.url == "/404.html" %}
  <url><loc>{{ p.url | absolute_url }}</loc></url>
{%- endunless -%}
{%- endfor %}
  <url><loc>{{ "/llms.txt" | absolute_url }}</loc></url>
  <url><loc>{{ "/llms-full.txt" | absolute_url }}</loc></url>
  <url><loc>{{ "/brochure.pdf" | absolute_url }}</loc></url>
</urlset>
